{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "REACT_APP_NETWORK_ID=97 REACT_APP_NODE_1=https://bsc-testnet.publicnode.com REACT_APP_NODE_2=https://bsc-testnet.bnbchain.org REACT_APP_NODE_3=https://bsc-testnet.drpc.org CI=false npm run build",
  "outputDirectory": "build",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
