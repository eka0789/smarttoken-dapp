REACT_APP_NETWORK_ID=56

# WalletConnect v2 (daftar gratis di https://cloud.walletconnect.com)
REACT_APP_WALLETCONNECT_PROJECT_ID=

# Opsional: Sentry error tracking (jika dikosongkan, tracking dinonaktifkan)
REACT_APP_SENTRY_DSN=

# BSC Mainnet public RPC nodes (urutkan paling andal di NODE_1;
# bsc-dataseed.binance.org sering rate-limited / ECONNRESET, taruh terakhir)
REACT_APP_NODE_1 = "https://bsc-dataseed1.defibit.io"
REACT_APP_NODE_2 = "https://bsc-dataseed1.ninicoin.io"
REACT_APP_NODE_3 = "https://bsc-dataseed.binance.org"

# Untuk testnet (chain 97), gunakan:
# REACT_APP_NETWORK_ID=97
# REACT_APP_NODE_1 = "https://data-seed-prebsc-1-s1.binance.org:8545/"
# REACT_APP_NODE_2 = "https://data-seed-prebsc-2-s1.binance.org:8545/"
# REACT_APP_NODE_3 = "https://data-seed-prebsc-1-s2.binance.org:8545/"
