# Copy this file to .env and fill in real values. Never commit .env.

# Private key of the deployer/owner account. ONLY use a dedicated deployer
# wallet with the minimum funds needed. If the old key that was committed to
# this repo still controls mainnet contracts, rotate ownership immediately.
DEPLOYER_PRIVATE_KEY=

# Etherscan/BscScan API key (https://bscscan.com/myapikey)
ETHERSCAN_API_KEY=

# Optional RPC overrides (defaults are public endpoints)
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
POLYGON_MAINNET_RPC=https://polygon-rpc.com
ETH_MAINNET_RPC=https://eth.llamarpc.com
FANTOM_RPC=https://rpc.ftm.tools
FANTOM_TESTNET_RPC=https://rpc.testnet.fantom.network
